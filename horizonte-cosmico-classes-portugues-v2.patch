 @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
-
-:root { --bg: #f7f6f2; --surface: #fff; --ink: #17171b; --muted: #68676f; --line: #e5e2dc; --accent: #7b61ff; --accent-dark: #5d46cf; --dark: #17151d; --soft: #eeebff; }
-html { font-size: 16px; min-height: 100%; }
-body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--ink); font-family: 'DM Sans', sans-serif; }
-body, button, input, textarea, select { font-family: 'DM Sans', sans-serif; }
-h1, h2, h3, .brand strong { font-family: 'Space Grotesk', sans-serif; }
-a { color: inherit; text-decoration: none; }
-a:hover { color: inherit; }
-.site-container { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
-.site-header { position: sticky; top: 0; z-index: 1000; background: rgba(247,246,242,.94); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(229,226,220,.9); }
-.site-nav { min-height: 78px; }
-.nav-inner { min-height: 78px; display: flex; align-items: center; gap: 32px; }
-.brand { display: inline-flex; align-items: center; gap: 11px; min-width: 220px; }
-.brand-mark { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; font-size: 16px; }
-.brand span:last-child { display: flex; flex-direction: column; line-height: 1.05; }
-.brand strong { font-size: 14px; letter-spacing: .08em; }
-.brand small { margin-top: 5px; color: var(--muted); font-size: 8px; letter-spacing: .13em; }
-.nav-menu { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
-.nav-links { display: flex; align-items: center; gap: 24px; }
-.nav-links a, .nav-login { font-size: 14px; color: #4d4b53; transition: color .2s ease; }
-.nav-links a:hover, .nav-login:hover { color: var(--ink); }
-.nav-account { display: flex; align-items: center; }
-.nav-signup { padding: 10px 16px; background: var(--ink); color: #fff; border-radius: 999px; font-size: 14px; margin-left: 14px; }
-.nav-signup:hover { color: #fff; background: #2c2933; }
