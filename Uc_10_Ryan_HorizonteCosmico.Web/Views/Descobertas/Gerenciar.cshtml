@model IEnumerable<Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Descoberta>
@{ ViewData["Title"] = "Gerenciar descobertas"; }
@section Styles { <link rel="stylesheet" href="~/css/crud.css" asp-append-version="true" /> }
<div class="crud-page"><div class="site-container">
<div class="crud-heading"><div><span class="eyebrow">PAINEL ADMINISTRATIVO</span><h1>Descobertas</h1><p>Gerencie rascunhos e publicações exibidas no site.</p></div><a asp-action="Create" class="button-primary">+ Nova descoberta</a></div>
<div class="crud-table-wrap"><table class="table crud-table"><thead><tr><th>Título</th><th>Categoria</th><th>Data</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Titulo</strong></td><td>@item.Categoria</td><td>@item.DataDescoberta.ToString("dd/MM/yyyy")</td><td>@item.Status</td><td class="crud-actions text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="button-secondary">Editar</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="button-secondary" type="submit" onclick="return confirm('Excluir esta descoberta?')">Excluir</button></form></td></tr> }</tbody></table></div>
</div></div>
