@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.ListaDescobertasViewModel
@{ ViewData["Title"] = "Descobertas"; }
@section Styles { <link rel="stylesheet" href="~/css/conteudo-publico.css" asp-append-version="true" /> }

<div class="pagina-conteudo">
    <div class="container-site">
        <div class="cabecalho-conteudo">
            <span class="rotulo-superior">CIÊNCIA EM DESTAQUE</span>
            <h1>Últimas descobertas</h1>
            <p>Explore resultados recentes e consulte os detalhes de cada publicação.</p>
        </div>

        @if (Model.Destaques.Count > 0)
        {
            <section class="secao-principais" aria-labelledby="destaques-descobertas">
                <div class="linha-titulo-secao">
                    <div>
                        <span class="rotulo-superior">EM EVIDÊNCIA</span>
                        <h2 id="destaques-descobertas">Principais descobertas</h2>
                    </div>
                    <span class="quantidade-resultados">@Model.Resultados.Count publicação(ões)</span>
                </div>
                <div class="grade-conteudo grade-principais">
                    @foreach (var item in Model.Destaques)
                    {
                        <a class="cartao-conteudo cartao-principal" asp-action="Details" asp-route-id="@item.Id">
                            <div class="midia-cartao @(string.IsNullOrWhiteSpace(item.ImagemCapa) ? "espaco-midia" : null)">
                                @if (!string.IsNullOrWhiteSpace(item.ImagemCapa))
                                {
                                    <img src="@item.ImagemCapa" alt="@item.Titulo" />
                                }
                                else
                                {
                                    <span>✦</span>
                                }
                            </div>
                            <div class="corpo-cartao">
                                <span class="categoria-cartao">@item.Categoria · @item.DataDescoberta.ToString("dd MMM yyyy")</span>
                                <h3>@item.Titulo</h3>
                                <p>@item.Resumo</p>
                                <span class="link-cartao">Ler descoberta →</span>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        <section class="resultados-conteudo" aria-labelledby="todas-descobertas">
            <div class="linha-titulo-secao">
                <div>
                    <span class="rotulo-superior">ARQUIVO</span>
                    <h2 id="todas-descobertas">Todas as descobertas</h2>
                </div>
            </div>

            <form class="filtros-conteudo" method="get">
                <div class="campo-filtro campo-pesquisa">
                    <label for="busca">Pesquisar</label>
                    <input id="busca" name="busca" value="@Model.Busca" placeholder="Digite um termo" />
                </div>
                <div class="campo-filtro">
                    <label for="categoria">Filtrar por categoria</label>
                    <select id="categoria" name="categoria">
                        <option value="">Todas as categorias</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria" selected="@(Model.Categoria == categoria)">@categoria</option>
                        }
                    </select>
                </div>
                <button class="botao-primario" type="submit">Aplicar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Busca) || !string.IsNullOrWhiteSpace(Model.Categoria))
                {
                    <a class="botao-secundario" asp-action="Index">Limpar</a>
                }
            </form>

            @if (Model.Resultados.Count == 0)
            {
                <div class="estado-vazio"><strong>Nenhuma descoberta encontrada.</strong><span>Tente outro termo ou categoria.</span></div>
            }
            else
            {
                <div class="grade-conteudo">
                    @foreach (var item in Model.Resultados)
                    {
                        <a class="cartao-conteudo" asp-action="Details" asp-route-id="@item.Id">
                            <div class="midia-cartao @(string.IsNullOrWhiteSpace(item.ImagemCapa) ? "espaco-midia" : null)">
                                @if (!string.IsNullOrWhiteSpace(item.ImagemCapa))
                                {
                                    <img src="@item.ImagemCapa" alt="@item.Titulo" />
                                }
                                else
                                {
                                    <span>✦</span>
                                }
                            </div>
                            <div class="corpo-cartao">
                                <span class="categoria-cartao">@item.Categoria · @item.DataDescoberta.ToString("dd/MM/yyyy")</span>
                                <h3>@item.Titulo</h3>
                                <p>@item.Resumo</p>
                                <span class="link-cartao">Ver detalhes →</span>
                            </div>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
</div>
