@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Descoberta
@{ ViewData["Title"] = "Nova descoberta"; }
<h1>Nova descoberta</h1><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-8 mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Categoria" class="form-label"></label><input asp-for="Categoria" class="form-control" /></div></div>
<div class="mb-3"><label asp-for="ImagemCapa" class="form-label">Imagem de capa (URL)</label><input asp-for="ImagemCapa" class="form-control" placeholder="https://..." /></div>
<div class="mb-3"><label asp-for="Resumo" class="form-label"></label><textarea asp-for="Resumo" class="form-control"></textarea></div><div class="mb-3"><label asp-for="Conteudo" class="form-label"></label><textarea asp-for="Conteudo" rows="6" class="form-control"></textarea></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="DataDescoberta" class="form-label"></label><input asp-for="DataDescoberta" type="date" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Rascunho</option><option>Publicado</option><option>Desativado</option></select></div><div class="col-md-4 mb-3 form-check mt-4"><input asp-for="Destaque" class="form-check-input" /><label asp-for="Destaque" class="form-check-label">Destaque</label></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="CreditoImagem" class="form-label">Crédito da imagem</label><input asp-for="CreditoImagem" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="Fonte" class="form-label"></label><input asp-for="Fonte" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="LinkFonte" class="form-label"></label><input asp-for="LinkFonte" class="form-control" /></div></div></div>
<button class="btn btn-primary">Salvar cadastro</button> <a asp-action="Gerenciar" class="btn btn-secondary">Cancelar</a></form>
