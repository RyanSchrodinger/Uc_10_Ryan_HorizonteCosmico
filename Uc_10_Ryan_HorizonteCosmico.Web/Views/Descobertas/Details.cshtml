@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Descoberta
@{ ViewData["Title"] = Model.Titulo; }
@section Styles { <link rel="stylesheet" href="~/css/conteudo-publico.css" asp-append-version="true" /> }

<div class="pagina-detalhe">
    <div class="container-site">
        <div class="metadados-detalhe"><span>@Model.Categoria</span><span>•</span><span>@Model.DataDescoberta.ToString("dd MMM yyyy")</span></div>
        <h1>@Model.Titulo</h1>
        <p class="resumo-detalhe">@Model.Resumo</p>

        <div class="estrutura-detalhe">
            <article class="principal-detalhe">
                <div class="destaque-detalhe @(string.IsNullOrWhiteSpace(Model.ImagemCapa) ? "espaco-detalhe" : null)">
                    @if (!string.IsNullOrWhiteSpace(Model.ImagemCapa))
                    {
                        <img src="@Model.ImagemCapa" alt="@Model.Titulo" />
                    }
                    else
                    {
                        <span>✦</span>
                    }
                </div>
                <div class="texto-detalhe">
                    @foreach (var paragrafo in Model.Conteudo.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p>@paragrafo</p>
                    }
                </div>
            </article>
            <aside class="informacoes-detalhe">
                <h2>Resumo</h2>
                <dl>
                    <dt>Categoria</dt><dd>@Model.Categoria</dd>
                    <dt>Data da descoberta</dt><dd>@Model.DataDescoberta.ToString("dd/MM/yyyy")</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Fonte)) { <dt>Fonte</dt><dd>@Model.Fonte</dd> }
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.LinkFonte))
                {
                    <a class="botao-secundario botao-largura-total" href="@Model.LinkFonte" target="_blank" rel="noopener noreferrer">Acessar fonte original ↗</a>
                }
            </aside>
        </div>
        <a class="link-voltar" asp-action="Index">← Voltar às descobertas</a>
    </div>
</div>
