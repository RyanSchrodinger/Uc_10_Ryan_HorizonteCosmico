@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.EditarPerfilViewModel
@{ ViewData["Title"] = "Editar perfil"; }
@section Styles { <link rel="stylesheet" href="~/css/editar-perfil.css" asp-append-version="true" /> }
<div class="pagina-perfil"><div class="container-site container-reduzido">
    <div class="cabecalho-pagina"><span class="rotulo-superior">MINHA CONTA</span><h1>Editar perfil</h1><p>Atualize os dados compartilhados pela sua conta.</p></div>
    <form asp-action="EditarPerfil" method="post" class="formulario-perfil"><div asp-validation-summary="ModelOnly" class="validacao"></div>
        <section class="secao-formulario"><h2>Dados da conta</h2><div class="campo"><label asp-for="NomeCompleto"></label><input asp-for="NomeCompleto" autocomplete="name" /></div><div class="campo"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><small>Se alterar o e-mail, será necessário confirmar o novo endereço.</small></div></section>
        <section class="secao-formulario"><h2>Alterar senha</h2><p class="ajuda-formulario">Preencha apenas se quiser trocar sua senha.</p><div class="campo"><label asp-for="SenhaAtual"></label><input asp-for="SenhaAtual" autocomplete="current-password" /></div><div class="campo"><label asp-for="NovaSenha"></label><input asp-for="NovaSenha" autocomplete="new-password" /></div><div class="campo"><label asp-for="ConfirmarNovaSenha"></label><input asp-for="ConfirmarNovaSenha" autocomplete="new-password" /></div></section>
        <div class="acoes-formulario"><a class="botao-secundario" asp-action="MeuPerfil">Cancelar</a><button class="botao-primario" type="submit">Salvar alterações</button></div>
    </form>
</div></div>
