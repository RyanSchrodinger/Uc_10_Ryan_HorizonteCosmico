@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.RedefinirSenhaViewModel
@{ ViewData["Title"] = "Redefinir senha"; }
@section Styles { <link rel="stylesheet" href="~/css/redefinir-senha.css" asp-append-version="true" /> }
<div class="pagina-conta"><div class="cartao-conta cartao-conta-pequeno">
    <div class="marca-conta">✦<span>HORIZONTE CÓSMICO</span></div><span class="rotulo-superior">NOVA SENHA</span><h1>Redefina sua senha</h1><p class="introducao-conta">Crie uma nova senha para voltar a acessar sua conta.</p>
    <form asp-action="RedefinirSenha" method="post"><div asp-validation-summary="ModelOnly" class="validacao"></div><input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" /><div class="campo"><label asp-for="NovaSenha"></label><input asp-for="NovaSenha" autocomplete="new-password" /></div><div class="campo"><label asp-for="ConfirmarNovaSenha"></label><input asp-for="ConfirmarNovaSenha" autocomplete="new-password" /></div><button class="botao-primario botao-largura-total" type="submit">Salvar nova senha</button></form>
    <a class="link-conta" asp-action="Login">Cancelar</a>
</div></div>
