@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.CadastroViewModel
@{ ViewData["Title"] = "Criar conta"; }
@section Styles { <link rel="stylesheet" href="~/css/cadastro.css" asp-append-version="true" /> }
<div class="pagina-conta"><div class="cartao-conta">
    <div class="marca-conta">✦<span>HORIZONTE CÓSMICO</span></div>
    <span class="rotulo-superior">NOVO ACESSO</span><h1>Crie sua conta</h1><p class="introducao-conta">Cadastre seus dados básicos. Depois, confirme o código enviado para o seu e-mail.</p>
    <form asp-action="Cadastro" method="post">
        <div asp-validation-summary="ModelOnly" class="validacao"></div>
        <div class="campo"><label asp-for="NomeCompleto"></label><input asp-for="NomeCompleto" autocomplete="name" /></div>
        <div class="campo"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /></div>
        <div class="campo"><label asp-for="Senha"></label><input asp-for="Senha" autocomplete="new-password" /></div>
        <div class="campo"><label asp-for="ConfirmarSenha"></label><input asp-for="ConfirmarSenha" autocomplete="new-password" /></div>
        <button class="botao-primario botao-largura-total" type="submit">Criar conta</button>
    </form>
    <p class="rodape-conta">Já tenho uma conta. <a asp-action="Login">Entrar</a></p>
</div></div>
