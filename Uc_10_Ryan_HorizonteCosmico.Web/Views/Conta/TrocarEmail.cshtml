@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.TrocarEmailViewModel
@{ ViewData["Title"] = "Trocar e-mail"; }
@section Styles { <link rel="stylesheet" href="~/css/trocar-email.css" asp-append-version="true" /> }
<div class="pagina-conta"><div class="cartao-conta cartao-conta-pequeno">
    <div class="marca-conta">✦<span>HORIZONTE CÓSMICO</span></div><span class="rotulo-superior">CADASTRO PENDENTE</span><h1>Trocar e-mail</h1><p class="introducao-conta">Informe o novo endereço. Enviaremos um novo código de confirmação.</p>
    <form asp-action="TrocarEmail" method="post"><input type="hidden" name="emailAtual" value="@ViewBag.EmailAtual" /><div asp-validation-summary="ModelOnly" class="validacao"></div><div class="campo"><label asp-for="NovoEmail"></label><input asp-for="NovoEmail" autocomplete="email" /></div><button class="botao-primario botao-largura-total" type="submit">Salvar e enviar código</button></form>
    <a class="link-conta" asp-action="CadastroPendente">Cancelar</a>
</div></div>
