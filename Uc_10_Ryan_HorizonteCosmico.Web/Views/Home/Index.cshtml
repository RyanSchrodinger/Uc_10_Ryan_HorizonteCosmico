@{
    ViewData["Title"] = "Início";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <section class="hero-section">
        <div class="site-container hero-grid">
            <div class="hero-copy">
                <span class="eyebrow">EXPLORE O UNIVERSO</span>
                <h1>Descubra os mistérios da <em>Astronomia</em></h1>
                <p>Lançamentos, descobertas e imagens incríveis em uma experiência clara e acessível.</p>
                <div class="hero-actions">
                    <a class="button-primary" href="#conteudo">Explorar descobertas</a>
                    <a class="button-secondary" href="#galeria">Ver galeria</a>
                </div>
            </div>
            <div class="hero-orbit" aria-hidden="true">
                <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
                <div class="planet">✦</div>
            </div>
        </div>
    </section>

    <section class="content-section" id="conteudo">
        <div class="site-container">
            <div class="section-heading"><span class="eyebrow">CIÊNCIA EM DESTAQUE</span><h2>Últimas descobertas</h2><p>Novidades científicas explicadas de forma direta.</p></div>
            <div class="feature-grid">
                <article class="feature-card"><span>DESCOBERTA</span><h3>Novo exoplaneta identificado</h3><p>Um possível mundo rochoso em uma estrela próxima.</p><a href="#explorar">Explorar conteúdo →</a></article>
                <article class="feature-card"><span>DESCOBERTA</span><h3>Galáxia distante observada</h3><p>A luz antiga ajuda a compreender o universo jovem.</p><a href="#explorar">Explorar conteúdo →</a></article>
                <article class="feature-card"><span>DESCOBERTA</span><h3>Estrela massiva em estudo</h3><p>Novos dados revelam etapas de sua evolução.</p><a href="#explorar">Explorar conteúdo →</a></article>
            </div>
        </div>
    </section>

    <section class="content-section section-muted" id="lancamentos">
        <div class="site-container split-section">
            <div><span class="eyebrow">MISSÕES ESPACIAIS</span><h2>Próximos lançamentos</h2><p>Acompanhe missões programadas, agências, veículos e locais de lançamento.</p></div>
            <div class="mission-list">
                <div><strong>Missão Aurora</strong><span>30 AGO • NASA • Centro espacial</span></div>
                <div><strong>Satélite climático</strong><span>12 SET • ESA • Base de lançamento</span></div>
                <div><strong>Sonda de pesquisa</strong><span>Data a definir • Missão científica</span></div>
            </div>
        </div>
    </section>

    <section class="content-section" id="galeria">
        <div class="site-container">
            <div class="section-heading"><span class="eyebrow">ASTROFOTOGRAFIA</span><h2>Galeria espacial</h2><p>Imagens do universo acompanhadas de descrição, autoria e créditos.</p></div>
            <div class="gallery-grid">
                <div class="gallery-card gallery-one"><span>GALÁXIA</span><strong>Galáxia de Andrômeda</strong></div>
                <div class="gallery-card gallery-two"><span>NEBULOSA</span><strong>Nebulosa em violeta</strong></div>
                <div class="gallery-card gallery-three"><span>LUA</span><strong>Superfície lunar</strong></div>
            </div>
        </div>
    </section>

    <section class="content-section section-dark" id="explorar">
        <div class="site-container explore-section">
            <span class="eyebrow">APRENDA EXPLORANDO</span>
            <h2>Conhecimento para olhar mais longe.</h2>
            <p>O Horizonte Cósmico organiza informações sobre descobertas, missões e objetos celestes em uma experiência simples e acessível.</p>
        </div>
    </section>
</div>
