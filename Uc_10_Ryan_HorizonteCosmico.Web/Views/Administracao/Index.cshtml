@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.AdministracaoViewModel
@{ ViewData["Title"] = "Painel administrativo"; }
@section Styles { <link rel="stylesheet" href="~/css/administracao.css" asp-append-version="true" /> }

<div class="estrutura-admin">
    <aside class="barra-lateral-admin">
        <a class="marca-admin" asp-controller="Administracao" asp-action="Index">
            <span class="icone-marca-admin">✦</span>
            <span><strong>HORIZONTE CÓSMICO</strong><small>ADMINISTRAÇÃO</small></span>
        </a>
        <nav class="navegacao-admin" aria-label="Navegação administrativa">
            <a class="ativo" asp-controller="Administracao" asp-action="Index">Dashboard</a>
            <a asp-controller="Descobertas" asp-action="Gerenciar">Descobertas</a>
            <a asp-controller="Lancamentos" asp-action="Gerenciar">Lançamentos</a>
            <a asp-controller="Astrofotografias" asp-action="Gerenciar">Astrofotografias</a>
            <a asp-controller="Home" asp-action="Index">Ver site público</a>
        </nav>
        <form class="sair-admin" asp-controller="Conta" asp-action="Logout" method="post"><button type="submit">Sair</button></form>
    </aside>

    <main class="principal-admin">
        <div class="barra-superior-admin">
            <div><span class="rotulo-superior">PAINEL ADMINISTRATIVO</span><h1>Visão geral</h1></div>
            <a class="botao-secundario" asp-controller="Home" asp-action="Index">Ver site</a>
        </div>

        <section class="indicadores-admin" aria-label="Resumo do sistema">
            <a class="indicador-admin" asp-controller="Descobertas" asp-action="Gerenciar"><span>Descobertas</span><strong>@Model.Descobertas</strong><small>@Model.Rascunhos rascunhos no total</small></a>
            <a class="indicador-admin" asp-controller="Lancamentos" asp-action="Gerenciar"><span>Lançamentos</span><strong>@Model.Lancamentos</strong><small>Missões cadastradas</small></a>
            <a class="indicador-admin" asp-controller="Astrofotografias" asp-action="Gerenciar"><span>Fotografias</span><strong>@Model.Astrofotografias</strong><small>Registros no acervo</small></a>
            <div class="indicador-admin suave"><span>Conteúdos ativos</span><strong>@Model.ConteudosAtivos</strong><small>Visíveis no site público</small></div>
        </section>

        <section class="grade-inferior-admin">
            <div class="recentes-admin">
                <div class="titulo-secao-admin"><div><span class="rotulo-superior">ATIVIDADE</span><h2>Conteúdos recentes</h2></div></div>
                @if (Model.Recentes.Count == 0)
                {
                    <div class="vazio-admin">Ainda não existem conteúdos cadastrados.</div>
                }
                else
                {
                    <div class="lista-recentes">
                        @foreach (var item in Model.Recentes)
                        {
                            <a class="item-recente" href="@item.Url"><span class="tipo-recente">@item.Tipo</span><strong>@item.Titulo</strong><time>@item.Data.ToString("dd/MM")</time></a>
                        }
                    </div>
                }
            </div>
            <div class="acoes-rapidas-admin">
                <span class="rotulo-superior">ATALHOS</span><h2>Ações rápidas</h2>
                <a class="acao-rapida" asp-controller="Descobertas" asp-action="Create">+ Nova descoberta</a>
                <a class="acao-rapida" asp-controller="Lancamentos" asp-action="Create">+ Novo lançamento</a>
                <a class="acao-rapida" asp-controller="Astrofotografias" asp-action="Create">+ Nova fotografia</a>
            </div>
        </section>
    </main>
</div>
