@model IEnumerable<Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Lancamento>
@{ ViewData["Title"] = "Gerenciar lançamentos"; }
@section Styles { <link rel="stylesheet" href="~/css/crud.css" asp-append-version="true" /> }
<div class="pagina-crud"><div class="container-site">
<div class="cabecalho-crud"><div><span class="rotulo-superior">PAINEL ADMINISTRATIVO</span><h1>Lançamentos</h1><p>Gerencie missões e o que será publicado no site.</p></div><a asp-action="Create" class="botao-primario">+ Novo lançamento</a></div>
<div class="envoltorio-tabela-crud"><table class="table tabela-crud"><thead><tr><th>Missão</th><th>Agência</th><th>Data</th><th>Situação</th><th>Publicação</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Nome</strong></td><td>@item.EmpresaAgencia</td><td>@item.DataHoraLancamento?.ToString("dd/MM/yyyy HH:mm")</td><td>@item.StatusLancamento</td><td>@item.StatusPublicacao</td><td class="acoes-crud text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="botao-secundario">Editar</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="botao-secundario" type="submit" onclick="return confirm('Excluir este lançamento?')">Excluir</button></form></td></tr> }</tbody></table></div>
</div></div>
