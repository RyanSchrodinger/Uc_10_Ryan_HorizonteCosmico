@model IEnumerable<Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Lancamento>
@{ ViewData["Title"] = "Gerenciar lançamentos"; }
@section Styles { <link rel="stylesheet" href="~/css/crud.css" asp-append-version="true" /> }
<div class="crud-page"><div class="site-container">
<div class="crud-heading"><div><span class="eyebrow">PAINEL ADMINISTRATIVO</span><h1>Lançamentos</h1><p>Gerencie missões e o que será publicado no site.</p></div><a asp-action="Create" class="button-primary">+ Novo lançamento</a></div>
<div class="crud-table-wrap"><table class="table crud-table"><thead><tr><th>Missão</th><th>Agência</th><th>Data</th><th>Situação</th><th>Publicação</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Nome</strong></td><td>@item.EmpresaAgencia</td><td>@item.DataHoraLancamento?.ToString("dd/MM/yyyy HH:mm")</td><td>@item.StatusLancamento</td><td>@item.StatusPublicacao</td><td class="crud-actions text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="button-secondary">Editar</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="button-secondary" type="submit" onclick="return confirm('Excluir este lançamento?')">Excluir</button></form></td></tr> }</tbody></table></div>
</div></div>
