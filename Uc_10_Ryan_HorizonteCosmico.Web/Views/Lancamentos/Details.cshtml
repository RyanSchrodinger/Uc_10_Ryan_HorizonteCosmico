@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Lancamento
@{ ViewData["Title"] = Model.Nome; }
@section Styles { <link rel="stylesheet" href="~/css/conteudo-publico.css" asp-append-version="true" /> }
<div class="pagina-detalhe">
    <div class="container-site">
        <div class="metadados-detalhe"><span>LANÇAMENTO</span><span>•</span><span>@Model.StatusLancamento</span></div>
        <h1>@Model.Nome</h1>
        <p class="resumo-detalhe">@Model.Descricao</p>
        <div class="estrutura-detalhe">
            <article class="principal-detalhe">
                <div class="destaque-detalhe @(string.IsNullOrWhiteSpace(Model.ImagemCapa) ? "espaco-detalhe" : null)">@if (!string.IsNullOrWhiteSpace(Model.ImagemCapa)) { <img src="@Model.ImagemCapa" alt="@Model.Nome" /> } else { <span>🚀</span> }</div>
                @if (!string.IsNullOrWhiteSpace(Model.ObjetivoMissao)) { <div class="texto-detalhe"><h2>Objetivo da missão</h2><p>@Model.ObjetivoMissao</p></div> }
            </article>
            <aside class="informacoes-detalhe">
                <h2>Resumo</h2>
                <dl>
                    <dt>Agência / empresa</dt><dd>@Model.EmpresaAgencia</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Foguete)) { <dt>Foguete</dt><dd>@Model.Foguete</dd> }
                    @if (!string.IsNullOrWhiteSpace(Model.LocalLancamento)) { <dt>Local</dt><dd>@Model.LocalLancamento</dd> }
                    @if (Model.DataHoraLancamento.HasValue) { <dt>Data e hora</dt><dd>@Model.DataHoraLancamento.Value.ToString("dd/MM/yyyy HH:mm")</dd> }
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.LinkTransmissao)) { <a class="botao-secundario botao-largura-total" href="@Model.LinkTransmissao" target="_blank" rel="noopener noreferrer">Acompanhar transmissão ↗</a> }
            </aside>
        </div>
        <a class="link-voltar" asp-action="Index">← Voltar aos lançamentos</a>
    </div>
</div>
