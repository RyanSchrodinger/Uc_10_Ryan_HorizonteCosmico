@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Lancamento
@{ ViewData["Title"] = "Novo lançamento"; }
<h1>Novo lançamento</h1><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-8 mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="EmpresaAgencia" class="form-label"></label><input asp-for="EmpresaAgencia" class="form-control" /></div></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Foguete" class="form-label"></label><input asp-for="Foguete" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="LocalLancamento" class="form-label"></label><input asp-for="LocalLancamento" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="DataHoraLancamento" class="form-label"></label><input asp-for="DataHoraLancamento" type="datetime-local" class="form-control" /></div></div>
<div class="mb-3"><label asp-for="ImagemCapa" class="form-label">Imagem de capa (URL)</label><input asp-for="ImagemCapa" class="form-control" placeholder="https://..." /></div>
<div class="mb-3"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" rows="4" class="form-control"></textarea></div><div class="mb-3"><label asp-for="ObjetivoMissao" class="form-label"></label><textarea asp-for="ObjetivoMissao" rows="4" class="form-control"></textarea></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="CreditoImagem" class="form-label">Crédito da imagem</label><input asp-for="CreditoImagem" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="LinkTransmissao" class="form-label">Link da transmissão</label><input asp-for="LinkTransmissao" class="form-control" /></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="StatusLancamento" class="form-label"></label><select asp-for="StatusLancamento" class="form-select"><option>Programado</option><option>Realizado</option><option>Cancelado</option></select></div><div class="col-md-6 mb-3"><label asp-for="StatusPublicacao" class="form-label"></label><select asp-for="StatusPublicacao" class="form-select"><option>Rascunho</option><option>Publicado</option><option>Desativado</option></select></div></div>
<button class="btn btn-primary">Salvar cadastro</button> <a asp-action="Gerenciar" class="btn btn-secondary">Cancelar</a></form>
