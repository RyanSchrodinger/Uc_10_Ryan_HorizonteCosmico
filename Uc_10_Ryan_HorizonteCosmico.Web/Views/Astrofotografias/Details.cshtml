@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Astrofotografia
@{ ViewData["Title"] = Model.Titulo; }
@section Styles { <link rel="stylesheet" href="~/css/conteudo-publico.css" asp-append-version="true" /> }
<div class="detail-page">
    <div class="site-container">
        <div class="detail-meta"><span>@Model.Categoria</span><span>•</span><span>ASTROFOTOGRAFIA</span></div>
        <h1>@Model.Titulo</h1>
        <p class="detail-lead">@Model.Descricao</p>
        <div class="detail-layout">
            <article class="detail-main">
                <div class="detail-hero photo-detail-hero @(string.IsNullOrWhiteSpace(Model.Imagem) ? "detail-placeholder" : null)">@if (!string.IsNullOrWhiteSpace(Model.Imagem)) { <img src="@Model.Imagem" alt="@Model.Titulo" /> } else { <span>✦</span> }</div>
                <div class="detail-copy"><p>@Model.Descricao</p></div>
            </article>
            <aside class="detail-summary">
                <h2>Dados da captura</h2>
                <dl>
                    <dt>Autor</dt><dd>@Model.Autor</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.LocalRegistro)) { <dt>Local</dt><dd>@Model.LocalRegistro</dd> }
                    @if (Model.DataRegistro.HasValue) { <dt>Data</dt><dd>@Model.DataRegistro.Value.ToString("dd/MM/yyyy")</dd> }
                    @if (!string.IsNullOrWhiteSpace(Model.Equipamento)) { <dt>Equipamento</dt><dd>@Model.Equipamento</dd> }
                    @if (!string.IsNullOrWhiteSpace(Model.CreditoImagem)) { <dt>Crédito</dt><dd>@Model.CreditoImagem</dd> }
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Link)) { <a class="button-secondary button-full" href="@Model.Link" target="_blank" rel="noopener noreferrer">Fonte original ↗</a> }
            </aside>
        </div>
        <a class="back-link" asp-action="Index">← Voltar à galeria</a>
    </div>
</div>
