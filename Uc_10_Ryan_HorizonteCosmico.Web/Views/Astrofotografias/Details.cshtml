@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Astrofotografia
@{ ViewData["Title"] = Model.Titulo; }
@section Styles { <link rel="stylesheet" href="~/css/conteudo-publico.css" asp-append-version="true" /> }
<div class="pagina-detalhe">
    <div class="container-site">
        <div class="metadados-detalhe"><span>@Model.Categoria</span><span>•</span><span>ASTROFOTOGRAFIA</span></div>
        <h1>@Model.Titulo</h1>
        <p class="resumo-detalhe">@Model.Descricao</p>
        <div class="estrutura-detalhe">
            <article class="principal-detalhe">
                <div class="destaque-detalhe destaque-fotografia-detalhe @(string.IsNullOrWhiteSpace(Model.Imagem) ? "espaco-detalhe" : null)">@if (!string.IsNullOrWhiteSpace(Model.Imagem)) { <img src="@Model.Imagem" alt="@Model.Titulo" /> } else { <span>✦</span> }</div>
                <div class="texto-detalhe"><p>@Model.Descricao</p></div>
            </article>
            <aside class="informacoes-detalhe">
                <h2>Dados da captura</h2>
                <dl>
                    <dt>Autor</dt><dd>@Model.Autor</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.LocalRegistro)) { <dt>Local</dt><dd>@Model.LocalRegistro</dd> }
                    @if (Model.DataRegistro.HasValue) { <dt>Data</dt><dd>@Model.DataRegistro.Value.ToString("dd/MM/yyyy")</dd> }
                    @if (!string.IsNullOrWhiteSpace(Model.Equipamento)) { <dt>Equipamento</dt><dd>@Model.Equipamento</dd> }
                    @if (!string.IsNullOrWhiteSpace(Model.CreditoImagem)) { <dt>Crédito</dt><dd>@Model.CreditoImagem</dd> }
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.Link)) { <a class="botao-secundario botao-largura-total" href="@Model.Link" target="_blank" rel="noopener noreferrer">Fonte original ↗</a> }
            </aside>
        </div>
        <a class="link-voltar" asp-action="Index">← Voltar à galeria</a>
    </div>
</div>
