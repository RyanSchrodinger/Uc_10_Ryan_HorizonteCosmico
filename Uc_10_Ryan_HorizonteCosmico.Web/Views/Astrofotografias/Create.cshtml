@model Uc_10_Ryan_HorizonteCosmico.Domain.Conteudos.Astrofotografia
@{ ViewData["Title"] = "Nova fotografia"; }
<h1>Nova fotografia</h1><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row"><div class="col-md-8 mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="Categoria" class="form-label"></label><input asp-for="Categoria" class="form-control" /></div></div>
<div class="mb-3"><label asp-for="Imagem" class="form-label"></label><input asp-for="Imagem" class="form-control" placeholder="URL da imagem" /></div><div class="mb-3"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control"></textarea></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Autor" class="form-label"></label><input asp-for="Autor" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="LocalRegistro" class="form-label"></label><input asp-for="LocalRegistro" class="form-control" /></div><div class="col-md-4 mb-3"><label asp-for="DataRegistro" class="form-label"></label><input asp-for="DataRegistro" type="date" class="form-control" /></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Equipamento" class="form-label"></label><input asp-for="Equipamento" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="Link" class="form-label">Fonte original</label><input asp-for="Link" class="form-control" /></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Rascunho</option><option>Publicado</option><option>Desativado</option></select></div><div class="col-md-6 mb-3"><label asp-for="CreditoImagem" class="form-label"></label><input asp-for="CreditoImagem" class="form-control" /></div></div>
<button class="btn btn-primary">Salvar cadastro</button> <a asp-action="Gerenciar" class="btn btn-secondary">Cancelar</a></form>
