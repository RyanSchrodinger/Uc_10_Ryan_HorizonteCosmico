@model Uc_10_Ryan_HorizonteCosmico.Web.ViewModels.ListaAstrofotografiasViewModel
@{ ViewData["Title"] = "Galeria"; }
@section Styles { <link rel="stylesheet" href="~/css/conteudo-publico.css" asp-append-version="true" /> }
<div class="pagina-conteudo">
    <div class="container-site">
        <div class="cabecalho-conteudo"><span class="rotulo-superior">GALERIA DO UNIVERSO</span><h1>Astrofotografias</h1><p>Veja registros do céu, seus autores e os equipamentos usados em cada captura.</p></div>
        <section class="secao-principais">
            <div class="linha-titulo-secao"><div><span class="rotulo-superior">EM EVIDÊNCIA</span><h2>Principais fotografias</h2></div><span class="quantidade-resultados">@Model.Resultados.Count fotografia(s)</span></div>
            <div class="grade-fotografias grade-fotografias-principais">
                @foreach (var item in Model.Destaques)
                {
                    <a class="cartao-fotografia" asp-action="Details" asp-route-id="@item.Id">
                        <div class="midia-fotografia @(string.IsNullOrWhiteSpace(item.Imagem) ? "espaco-midia" : null)">@if (!string.IsNullOrWhiteSpace(item.Imagem)) { <img src="@item.Imagem" alt="@item.Titulo" /> } else { <span>✦</span> }</div>
                        <div class="corpo-fotografia"><span class="categoria-cartao">@item.Categoria</span><h3>@item.Titulo</h3><p>@item.Autor</p></div>
                    </a>
                }
            </div>
        </section>
        <section class="resultados-conteudo">
            <div class="linha-titulo-secao"><div><span class="rotulo-superior">ACERVO</span><h2>Todas as fotografias</h2></div></div>
            <form class="filtros-conteudo" method="get">
                <div class="campo-filtro campo-pesquisa"><label for="busca">Pesquisar</label><input id="busca" name="busca" value="@Model.Busca" placeholder="Título, autor ou tema" /></div>
                <div class="campo-filtro"><label for="categoria">Categoria</label><select id="categoria" name="categoria"><option value="">Todas</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria" selected="@(Model.Categoria == categoria)">@categoria</option> }</select></div>
                <button class="botao-primario" type="submit">Aplicar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Busca) || !string.IsNullOrWhiteSpace(Model.Categoria)) { <a class="botao-secundario" asp-action="Index">Limpar</a> }
            </form>
            @if (Model.Resultados.Count == 0)
            {
                <div class="estado-vazio"><strong>Nenhuma fotografia encontrada.</strong><span>Tente outro termo ou categoria.</span></div>
            }
            else
            {
                <div class="grade-fotografias">
                    @foreach (var item in Model.Resultados)
                    {
                        <a class="cartao-fotografia" asp-action="Details" asp-route-id="@item.Id"><div class="midia-fotografia @(string.IsNullOrWhiteSpace(item.Imagem) ? "espaco-midia" : null)">@if (!string.IsNullOrWhiteSpace(item.Imagem)) { <img src="@item.Imagem" alt="@item.Titulo" /> } else { <span>✦</span> }</div><div class="corpo-fotografia"><span class="categoria-cartao">@item.Categoria</span><h3>@item.Titulo</h3><p>@item.Autor</p><span class="link-cartao">Ver fotografia →</span></div></a>
                    }
                </div>
            }
        </section>
    </div>
</div>
